# AgentWeave runtime configuration
#
# Copy this file to .env and fill in your own OpenAI-compatible endpoints.
# Do not commit .env.

OPENAI_API_KEY=not-needed

# Chat model
CHAT_BASE_URL=http://localhost:8000/v1
CHAT_MODEL=qwen3.6-27b
CHAT_API_KEY=not-needed
CHAT_MAX_TOKENS=8192
CHAT_CONTEXT_WINDOW=32768

# Memory embedding model
EMBEDDING_BASE_URL=http://localhost:8002/v1
EMBEDDING_MODEL=qwen3-embedding-4b
EMBEDDING_API_KEY=not-needed
EMBEDDING_CLIENT_TIMEOUT=60
MEMORY_EMBEDDING_ENABLED=1

# Memory / runtime switches
MEMORY_ENABLED=1
AGENTWEAVE_TIMEZONE=Asia/Hong_Kong
OPENAI_CLIENT_TIMEOUT=60
OPENAI_CLIENT_MAX_RETRIES=2
# CHAT_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}

# Text2SQL database backend
# Prepare the DB before starting runtime. This writes .agentweave/text2sql.env,
# which is loaded automatically by Streamlit and agentweave-server startup.
# uv run agentweave-prepare-text2sql --overwrite
# uv run agentweave-prepare-text2sql --csv-root /absolute/or/project/path --overwrite
# TEXT2SQL_BACKEND=sqlite
# TEXT2SQL_DATABASE_URL=sqlite:////absolute/path/to/text2sql.sqlite

# RAG knowledge index
# Prepare the Markdown index before starting runtime. This writes .agentweave/rag.env,
# which is loaded automatically by Streamlit and agentweave-server startup.
# uv run agentweave-prepare-rag
# uv run agentweave-prepare-rag --source-root /absolute/or/project/path --overwrite
# RAG_CHUNK_CHARS=500
# RAG_CHUNK_OVERLAP=50
# RAG_INDEX_PATH=/absolute/path/to/rag_index.json

# Result store
SQL_RESULT_SAMPLE_ROWS=50
SQL_RESULT_STORE_MAX_ROWS=1000
SQL_RESULT_CELL_MAX_CHARS=300
# SQL_RESULT_TTL_HOURS=24

# HTTP/SSE backend server
AGENTWEAVE_SERVER_HOST=127.0.0.1
AGENTWEAVE_SERVER_PORT=8765
AGENTWEAVE_SERVER_TOKEN=dev-token
AGENTWEAVE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENTWEAVE_RUN_CACHE_MAX=1000
AGENTWEAVE_RUN_CACHE_TTL_SECONDS=21600
